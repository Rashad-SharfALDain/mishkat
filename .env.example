# Application Environment Configuration Template
# Duplicate this file as .env and provide your own private secrets.

PORT=5000
NODE_ENV=production
JWT_SECRET=your_secure_random_jwt_secret_key_change_in_production
ADMIN_EMAIL=admin@mishkat.edu.sa
ADMIN_INITIAL_PASSWORD=your_initial_secure_setup_password

# Frontend Base URL Configuration (Centralized for Password Recovery & User Links)
# LOCAL:
# FRONTEND_BASE_URL=http://localhost:3002
# STAGING:
# FRONTEND_BASE_URL=https://<staging-domain>
# PRODUCTION:
# FRONTEND_BASE_URL=https://<official-domain>
FRONTEND_BASE_URL=http://localhost:3002

# SMTP Email Service Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@mishkat.edu.sa
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM="مؤسسة مِشكاة التربوية <no-reply@mishkat.edu.sa>"
